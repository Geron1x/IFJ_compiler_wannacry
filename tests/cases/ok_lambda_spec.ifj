import ifj26.*
// spec 5.7 example, val add on one line
def foo(x: Int) = x + 5
def bar(a: Int, f: (Int) => Boolean) =
  val result = f(a)
  if result then
    print("f uspelo")
  else
    print("f neuspelo")
def goo(): (Int) => String =
  return (a: Int) =>
    val strA = toStr(a)
    "cislo" + strA

@main def main(): Unit =
  val add: (Int, Int) => Int = (left: Int, right: Int) => left + right
  val positive = (value: Int) => value > 0
  val addFive: (Int) => Int = foo

  val x = add(10, 8)
  val y = addFive(x)
  bar(y, positive)
